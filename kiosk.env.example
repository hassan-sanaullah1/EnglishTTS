# Put these in the Mari kiosk's own environment to route its ENGLISH TTS here.
# The kiosk reads them in test/Mari-Interactive-Kiosk/server/config.py; no kiosk code changes needed.

APP_EN_TTS=remote                              # switch English TTS off local Kokoro, onto this server
APP_REMOTE_TTS_API_BASE=http://127.0.0.1:8080  # or http://mari-tts:8080 on a shared docker network
APP_REMOTE_TTS_API_PATH=/v1/audio/speech
APP_REMOTE_TTS_MODEL=kokoro
APP_REMOTE_TTS_RESPONSE_FORMAT=mp3
APP_REMOTE_TTS_TOKEN=                          # must match MARI_TTS_TOKEN if that is set

# Which voice the kiosk asks for. Any of these work:
#   mari_female / mari_male / female / male      <- clearest
#   af_heart, am_adam, ...                       <- Kokoro names: *f_* -> female, *m_* -> male
APP_TTS_VOICE_ENGLISH=mari_female

# Urdu is untouched: it stays on Uplift (APP_UPLIFT_*). This server is English only.
