# Mari kiosk TTS - all the settings that matter day to day, in one place.
#
# Edit this file, then restart to apply:
#   docker:      docker compose restart mari-tts          (or: docker restart mari-tts)
#   host (no     pkill -f "uvicorn server:app"; then re-run the same uvicorn command
#   Docker GPU):  (see README.md "Run it without Docker")
#
# A real environment variable (exported, or set in docker-compose.yml's `environment:` block)
# always overrides a value here - this file is the default, not the only word. Comments after
# a value (preceded by a space and #) are ignored, so you can annotate inline.

# ────────────────────────────────────────────────────────────────────────────────────────────
# VOICE QUALITY / SPEED trade-off
# ────────────────────────────────────────────────────────────────────────────────────────────

# Diffusion steps per sentence. Higher = better quality, slower, (very slightly) more VRAM.
# Measured 2026-10-20: 32 steps gave RTF 0.36-0.63 (a 10s answer in ~5-7s). Not yet ear-checked
# against 16 - if you try it, listen before trusting it as the new default.
MARI_NUM_STEP=16

# Default playback speed when a request doesn't specify one. 1.0 = natural. >1 faster, <1 slower.
# This is the fallback both voices use when they have no speed of their own set below.
MARI_DEFAULT_SPEED=0.7

# Per-voice override - a male and a female voice often don't want the same rate. Leave blank to
# just use MARI_DEFAULT_SPEED for that voice. A per-voice-id override also works
# (MARI_SPEED_UPLIFT_MALE, MARI_SPEED_LULLABY_FEMALE), if you ever register a third voice and
# want gender alone to not decide it.
MARI_SPEED_MALE=
MARI_SPEED_FEMALE=

# Silence inserted between sentences of a multi-sentence answer, in milliseconds.
MARI_GAP_MS=220

# Longest chunk of text sent to the model in one generation (characters). Longer answers are
# split on sentence/comma boundaries first. Smaller = more, shorter generations (helps the demo
# start playback sooner); larger = fewer API calls to the model but a longer wait for the first
# chunk. 240 is roughly one to two sentences.
MARI_MAX_CHARS=240

# ────────────────────────────────────────────────────────────────────────────────────────────
# PRONUNCIATION
# ────────────────────────────────────────────────────────────────────────────────────────────

# Rewrite Pakistani-origin names into Urdu script before synthesis (Fauji -> فوجی, Pakistan ->
# پاکستان, etc.) - see app/lexicon.json and app/build_lexicon.py. 1 = on, 0 = off (plain Roman
# spelling, which mispronounces most of these names). Per-request override: {"lexicon": false}.
# Applies the same way to Urdu and code-switched text: the lexicon matches English-spelled
# names wherever they appear, even inside an otherwise-Urdu sentence.
MARI_USE_LEXICON=1

# Urdu and Urdu+English code-switched text need NO separate setting or endpoint - just send it
# as `input`, same voices, same /v1/audio/speech. OmniVoice is multilingual and the two
# registered voices were cloned from Urdu reference clips in the first place, so Urdu text is,
# if anything, more natural for them than English. Sentence splitting recognises Urdu
# punctuation (۔ ؟ ،) as well as Latin (. ? ,), so a reply typed with "۔" chunks correctly too.

# ────────────────────────────────────────────────────────────────────────────────────────────
# GPU SHARING - this card also runs Audio2Face (lip-sync avatar). Both have OOM'd before.
# ────────────────────────────────────────────────────────────────────────────────────────────

# "cuda:0" for GPU (normal), "cpu" to run without one (far slower, but frees the whole GPU for
# other services - useful if a2f alone is enough to crowd a 6 GB card).
MARI_DEVICE=cuda:0

# Hard ceiling on the fraction of total GPU memory this process may ever use, so it can never
# be the one that starves another GPU tenant (a2f OOM'd once in production on this card).
# Measured 2026-10-20 on the RTX 4050 Laptop (6141 MiB): our steady-state use is ~2.1 GiB, peak
# during generation only ~30 MiB above that. 0.42 (~2.4 GiB) leaves real margin above that and
# the rest of the card for a2f. Set to 0 to disable the ceiling entirely (e.g. if this is ever
# the GPU's only tenant). Lower it (e.g. 0.35) for more safety margin for a2f, at the risk of a
# CUDA OOM in US if a request needs more than the ceiling allows.
MARI_VRAM_FRACTION=0.42

# ────────────────────────────────────────────────────────────────────────────────────────────
# SERVER
# ────────────────────────────────────────────────────────────────────────────────────────────

# Audio container returned when a request doesn't specify response_format.
MARI_DEFAULT_FORMAT=mp3

# Load both voices and synthesize one throwaway line each at startup, so the FIRST real request
# doesn't pay the model/prompt load cost. 1 = on (adds a few seconds to startup), 0 = off.
MARI_WARMUP=1

# Require "Authorization: Bearer <token>" on every request. Leave blank to accept any request
# (matches the kiosk's own behaviour: it only sends the header when ITS token is configured).
# If you set this, also set APP_REMOTE_TTS_TOKEN to the same value in the kiosk's .env.
MARI_TTS_TOKEN=

# Log verbosity: DEBUG, INFO, WARNING, ERROR.
MARI_LOG=INFO
